# Copy to .env and fill in. Never commit .env.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_SECRET=CHANGE_ME  # placeholder is too short on purpose: the app refuses to start until you replace it
# Separate secret ElevenLabs sends to POST /elevenlabs/init (min 32 chars, must differ from TOOL_SECRET)
INIT_WEBHOOK_SECRET=CHANGE_ME
# HMAC secret from the ElevenLabs post-call webhook; unset = call summaries off (must differ from the others)
# POST_CALL_WEBHOOK_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
# BEAR_ENV=dev   # local only: allows no TOOL_SECRET and enables POST /admin/reset
DATABASE_URL=sqlite:///./vicecity.db
SHOP_ID=vice-city-auto
# Folder of per-shop YAML files (default: the repo's shops/ folder).
# SHOPS_DIR=./shops
# Tool requests time out after this many milliseconds (positive integer).
TOOL_DEADLINE_MS=4000
# The public https origin of this backend. The tools/ scripts build tool URLs from it, and staff alert
# emails link to <PUBLIC_BASE_URL>/admin.
# PUBLIC_BASE_URL=https://bear.example.com
# ELEVENLABS_TOOL_SECRET_ID=the id of the ElevenLabs secret holding TOOL_SECRET (never the value)
# ALERTS_MODE=log   # off | log (one 'not delivered' log line per event) | email (also emails the shop file's alerts.email list)
# With ALERTS_MODE=email both of these are required (Resend, https://resend.com; verify the sending domain first):
# ALERTS_EMAIL_API_KEY=re_CHANGE_ME
# ALERTS_EMAIL_FROM=Bear <alerts@your-verified-domain.example>
